PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Web Push notifications for editor lock-screen alerts.
# Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Optional but recommended when sending notification images from behind a proxy.
PUBLIC_BASE_URL=https://your-news-domain.example
DEEPSEEK_API_KEY=
DEFAULT_AI_PROVIDER=gemini
# Set these on the backend only. DATA_DIR must be outside the source release.
# NODE_ENV=production
# DATA_DIR=/data
# ADMIN_INITIAL_PASSWORD=generate-a-unique-password-of-at-least-16-characters
ENABLE_NEWS_CLEANUP=false
# Shared key required by GET /api/external-news/forwarded.
EXTERNAL_NEWS_API_KEY=generate-a-long-random-secret
# Public API host used in exported image URLs, for example https://nms-api.example.com
NMS_PUBLIC_BASE_URL=
# Optional source name included in exported data.
NMS_EXTERNAL_SOURCE=The Cliff News NMS
# Optional destination for automatic delivery when an editor forwards an article.
# NMS keeps the operator handoff even if this destination is temporarily unavailable.
EXTERNAL_NEWS_INGEST_URL=
# Sent as a Bearer token to EXTERNAL_NEWS_INGEST_URL when configured.
EXTERNAL_NEWS_INGEST_API_KEY=
# Optional separate key the external site can use when sending posted URLs back.
# If blank, NMS accepts EXTERNAL_NEWS_INGEST_API_KEY for the callback.
EXTERNAL_NEWS_CALLBACK_API_KEY=
# Newspaper generator API — receives bundled processed news for page generation.
NEWSPAPER_GENERATOR_URL=https://generator.pagemint1.gautamenterprises.org/api/nms-bundle
NEWSPAPER_GENERATOR_API_KEY=
# Optional PageMint external target ID. Numeric NMS target_user_id is still used for callbacks.
NEWSPAPER_GENERATOR_PAGEMINT_USER_ID=cliffdemo3
# Optional inbound key for POST /api/webhook/newspaper-pdf.
# If set, the generator must send it as x-webhook-key or x-api-key.
NEWSPAPER_GENERATOR_WEBHOOK_KEY=
